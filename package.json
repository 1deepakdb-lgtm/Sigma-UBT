{
  "name": "sigma-ubt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "./node_modules/prisma/build/index.js generate && npx next build",
    "postinstall": "prisma generate",
    "start": "node server.js",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "desktop:run": "electron electron/main.cjs",
    "desktop:dist:mac": "electron-builder --mac",
    "desktop:dist:win": "electron-builder --win",
    "desktop:dist:all": "electron-builder -mw",
    "android:build": "cd android && export JAVA_HOME=/Users/deepakbhatt/development/jdk-17/Contents/Home && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../public/downloads/ExamJK.apk",
    "android:clean": "cd android && ./gradlew clean"
  },
  "build": {
    "appId": "com.examjk.app",
    "productName": "ExamJK",
    "copyright": "Copyright © 2026 ExamJK",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "public/**/*"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/icon-512.png",
      "category": "public.app-category.education"
    },
    "win": {
      "target": ["nsis"],
      "icon": "public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "edge-tts-universal": "^1.4.0",
    "jose": "^5.9.6",
    "mammoth": "^1.13.0",
    "mime-types": "^3.0.2",
    "next": "^14.2.15",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
